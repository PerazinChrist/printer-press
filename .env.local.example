# URL de l'installation WordPress qui heberge printerpress-core.
PP_API_URL=http://localhost/simplyprint/wp-json/pp/v1

# Cle d'API affichee dans PrinterPress > Reglages (WordPress).
# Elle reste sur le serveur Next.js : jamais exposee au navigateur.
PP_API_KEY=

# Identifiant client Google OAuth (type "Application Web").
# Doit etre identique a celui saisi dans PrinterPress > Reglages.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
